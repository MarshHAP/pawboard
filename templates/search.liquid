<div class="container page-narrow">
  <div class="section-head">
    <h2>Search</h2>
    {% if search.performed %}<p>{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for "{{ search.terms | escape }}"</p>{% endif %}
  </div>
  <form action="{{ routes.search_url }}" method="get" role="search" class="form-page">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search our store" aria-label="Search">
    <button type="submit" class="btn btn-primary btn-block">Search</button>
  </form>
  {% if search.performed and search.results.size > 0 %}
    <div class="grid" style="margin-top:34px">
      {% for item in search.results %}
        {% if item.object_type == 'product' %}
          {% render 'product-card', product: item %}
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</div>
