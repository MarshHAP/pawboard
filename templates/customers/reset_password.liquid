<div class="container page-narrow">
  <div class="section-head"><h2>Reset your password</h2></div>
  {% form 'reset_customer_password', class: 'form-page' %}
    {{ form.errors | default_errors }}
    <label for="reset-password">New password</label>
    <input type="password" name="customer[password]" id="reset-password" autocomplete="new-password" required>
    <label for="reset-password-confirm">Confirm password</label>
    <input type="password" name="customer[password_confirmation]" id="reset-password-confirm" autocomplete="new-password" required>
    <button type="submit" class="btn btn-primary btn-block">Reset password</button>
  {% endform %}
</div>
