<div class="container page-narrow">
  <div class="section-head"><h2>Addresses</h2></div>
  {% paginate customer.addresses by 10 %}
    {% for address in customer.addresses %}
      <div class="address-card">
        {% if address == customer.default_address %}<strong>Default</strong><br>{% endif %}
        {{ address | format_address }}
      </div>
    {% endfor %}
    {% if paginate.pages > 1 %}<div class="pagination">{{ paginate | default_pagination }}</div>{% endif %}
  {% endpaginate %}
  <h3 class="h-sub">Add a new address</h3>
  {% form 'customer_address', customer.new_address, class: 'form-page' %}
    <label for="addr-first">First name</label>
    <input type="text" id="addr-first" name="address[first_name]" autocomplete="given-name">
    <label for="addr-last">Last name</label>
    <input type="text" id="addr-last" name="address[last_name]" autocomplete="family-name">
    <label for="addr-address1">Address</label>
    <input type="text" id="addr-address1" name="address[address1]" autocomplete="address-line1">
    <label for="addr-city">City</label>
    <input type="text" id="addr-city" name="address[city]" autocomplete="address-level2">
    <label for="addr-country">Country/region</label>
    <select id="addr-country" name="address[country]" data-default="{{ form.country }}">{{ all_country_option_tags }}</select>
    <label for="addr-zip">Postal/ZIP code</label>
    <input type="text" id="addr-zip" name="address[zip]" autocomplete="postal-code">
    <button type="submit" class="btn btn-primary btn-block">Add address</button>
  {% endform %}
  <p style="margin-top:22px"><a href="{{ routes.account_url }}" class="link">&larr; Back to account</a></p>
</div>
