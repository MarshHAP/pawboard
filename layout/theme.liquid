<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {%- if template == 'index' -%}
    <title>PawBoard - Nail care, the natural way</title>
    <meta name="description" content="Let your dog file their own nails - safely, naturally and happily. PawBoard turns nail care into a fun, rewarding game.">
  {%- else -%}
    <title>{{ page_title | replace: shop.name, 'PawBoard' }}{% unless page_title contains 'PawBoard' %} | PawBoard{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {%- endif -%}
  <link rel="canonical" href="{{ canonical_url }}">
  {%- liquid
    assign og_title = 'PawBoard - Nail care, the natural way'
    assign og_description = 'Let your dog file their own nails - safely, naturally and happily. PawBoard turns nail care into a fun, rewarding game.'
    if template != 'index' and page_title != blank
      assign og_title = page_title | replace: shop.name, 'PawBoard'
    endif
    if template != 'index' and page_description != blank
      assign og_description = page_description
    endif
    assign og_image = 'pb-hero-dog.jpg' | asset_url
    if product.featured_image
      assign og_image = product.featured_image | image_url: width: 1200
    elsif all_products['pawboard'].featured_image
      assign og_image = all_products['pawboard'].featured_image | image_url: width: 1200
    endif
  -%}
  <meta property="og:type" content="{% if template contains 'product' %}product{% else %}website{% endif %}">
  <meta property="og:site_name" content="PawBoard">
  <meta property="og:title" content="{{ og_title | escape }}">
  <meta property="og:description" content="{{ og_description | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:image" content="{{ og_image }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ og_title | escape }}">
  <meta name="twitter:description" content="{{ og_description | escape }}">
  <meta name="twitter:image" content="{{ og_image }}">
  <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
  <meta name="theme-color" content="#F26F21">
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Caveat:wght@600;700&display=swap" rel="stylesheet">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {%- liquid
    assign seo_product = product
    if template == 'index'
      assign seo_product = settings.hero_product
      if seo_product == blank or seo_product.title == blank
        assign seo_product = all_products['pawboard']
      endif
    endif
  -%}
  {%- if seo_product and seo_product.title != blank -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ seo_product.title | json }},
    "description": {{ seo_product.description | strip_html | truncate: 300 | json }},
    "url": {{ shop.url | append: seo_product.url | json }},
    {%- if seo_product.featured_image -%}"image": {{ seo_product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},{%- endif -%}
    "brand": { "@type": "Brand", "name": "PawBoard" },
    "aggregateRating": { "@type": "AggregateRating", "ratingValue": {{ settings.rating_value | default: '4.8' | json }}, "reviewCount": {{ settings.review_count | default: '1200' | remove: ',' | remove: '+' | json }} },
    "offers": {
      "@type": "Offer",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ seo_product.price | money_without_currency | remove: ',' | json }},
      "availability": "https://schema.org/{% if seo_product.available %}InStock{% else %}OutOfStock{% endif %}",
      "url": {{ shop.url | append: seo_product.url | json }}
    }
  }
  </script>
  {%- endif -%}
</head>
<body data-currency-symbol="{{ cart.currency.symbol }}" class="template-{{ template | split: '.' | first }}">

  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header" data-header>
    <div class="container header-inner">
      <a class="logo" href="{{ routes.root_url }}" aria-label="PawBoard home">
        {% render 'icon', name: 'paw', class: 'logo-mark' %}
        <span class="logo-text">
          <span class="logo-word">PawBoard</span>
          <span class="logo-tag">Happier paws. Brighter days.</span>
        </span>
      </a>

      <nav class="site-nav" aria-label="Primary">
        <a href="{{ routes.root_url }}#why">Why PawBoard</a>
        <a href="{{ routes.root_url }}#reviews">Reviews</a>
        <a href="{{ routes.root_url }}#how-it-works">How It Works</a>
        <a href="{{ routes.root_url }}#faq">FAQ</a>
      </nav>

      <div class="header-actions">
        <a class="icon-btn" href="{{ routes.search_url }}" aria-label="Search">{% render 'icon', name: 'search' %}</a>
        <a class="icon-btn" href="{{ routes.account_url }}" aria-label="Account">{% render 'icon', name: 'user' %}</a>
        <a class="icon-btn icon-btn--cart" href="{{ routes.cart_url }}" aria-label="Cart">
          {% render 'icon', name: 'cart' %}
          <span class="cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
        </a>
        <a class="btn btn-primary btn-sm header-cta" href="{{ routes.root_url }}#buy">{% render 'icon', name: 'cart' %}<span>Get PawBoard</span></a>
        <button class="icon-btn nav-toggle" type="button" aria-label="Menu" aria-expanded="false" data-nav-toggle>{% render 'icon', name: 'menu' %}</button>
      </div>
    </div>
    <div class="mobile-nav" data-mobile-nav hidden>
      <a href="{{ routes.root_url }}#why">Why PawBoard</a>
      <a href="{{ routes.root_url }}#reviews">Reviews</a>
      <a href="{{ routes.root_url }}#how-it-works">How It Works</a>
      <a href="{{ routes.root_url }}#faq">FAQ</a>
      <a class="btn btn-primary" href="{{ routes.root_url }}#buy">Get PawBoard</a>
    </div>
  </header>

  <main id="main">
    {{ content_for_layout }}
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-top">
        <div class="footer-brand">
          <a class="logo" href="{{ routes.root_url }}" aria-label="PawBoard home">
            {% render 'icon', name: 'paw', class: 'logo-mark' %}
            <span class="logo-text">
              <span class="logo-word">PawBoard</span>
              <span class="logo-tag">Happier paws. Brighter days.</span>
            </span>
          </a>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href="{{ routes.root_url }}#buy">Shop</a>
          <a href="{{ routes.root_url }}#why">About Us</a>
          <a href="{{ routes.root_url }}#reviews">Reviews</a>
          <a href="{{ routes.root_url }}#faq">FAQ</a>
          <a href="mailto:{{ shop.email }}">Contact</a>
        </nav>
        <div class="footer-newsletter">
          <h4>Join our pack</h4>
          <p>Get tips, pet care advice and exclusive offers.</p>
          {% form 'customer', class: 'newsletter' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {% if form.posted_successfully? %}
              <p class="newsletter-success">Welcome to the pack!</p>
            {% else %}
              <input type="email" name="contact[email]" placeholder="Your email address" required aria-label="Email address">
              <button type="submit" class="btn btn-primary">Subscribe</button>
            {% endif %}
          {% endform %}
        </div>
        <div class="footer-social">
          <a href="{{ settings.social_instagram | default: '#' }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>
          <a href="{{ settings.social_facebook | default: '#' }}" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>
          <a href="{{ settings.social_youtube | default: '#' }}" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a>
          <a href="{{ settings.social_pinterest | default: '#' }}" aria-label="Pinterest">{% render 'icon', name: 'pinterest' %}</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>&copy; {{ 'now' | date: '%Y' }} PawBoard. All rights reserved.</span>
        <nav class="footer-legal" aria-label="Legal">
          {% if shop.privacy_policy %}<a href="{{ shop.privacy_policy.url }}">Privacy Policy</a>{% else %}<a href="{{ routes.root_url }}#faq">Privacy Policy</a>{% endif %}
          {% if shop.terms_of_service %}<a href="{{ shop.terms_of_service.url }}">Terms of Service</a>{% else %}<a href="{{ routes.root_url }}#faq">Terms of Service</a>{% endif %}
          {% if shop.shipping_policy %}<a href="{{ shop.shipping_policy.url }}">Shipping</a>{% else %}<a href="{{ routes.root_url }}#faq">Shipping</a>{% endif %}
          {% if shop.refund_policy %}<a href="{{ shop.refund_policy.url }}">Returns</a>{% else %}<a href="{{ routes.root_url }}#faq">Returns</a>{% endif %}
        </nav>
      </div>
    </div>
  </footer>

  <div class="toast" data-toast role="status" aria-live="polite" hidden>
    {% render 'icon', name: 'check-circle' %}
    <span data-toast-text>Added to cart</span>
    <a href="{{ routes.cart_url }}">View cart</a>
  </div>

  <div class="video-modal" data-video-modal hidden>
    <div class="video-modal-backdrop" data-video-close></div>
    <div class="video-modal-dialog" role="dialog" aria-modal="true" aria-label="Watch how it works">
      <button class="video-modal-close" type="button" aria-label="Close" data-video-close>{% render 'icon', name: 'close' %}</button>
      <div class="video-modal-frame" data-video-frame></div>
    </div>
  </div>

  {{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
